{
  "name": "tool-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint src contracts vite.config.ts",
    "typecheck": "tsc -p tsconfig.core.json && vue-tsc --noEmit -p tsconfig.app.json",
    "test:unit": "vitest run src",
    "test:contracts": "vitest run contracts",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run test:contracts",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "vrt:baseline": "node vrt/baseline.ts",
    "vrt": "node vrt/compare.ts",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "typecheck:storybook": "vue-tsc --noEmit -p .storybook/tsconfig.json",
    "gallery": "echo 'Design Pattern Gallery: http://localhost:4184/gallery.html' && vite --port 4184 --strictPort"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/noto-sans-jp": "5.3.1",
    "dexie": "4.4.7",
    "vue": "3.5.45",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@storybook/vue3-vite": "10.6.8",
    "@types/node": "24.19.2",
    "@types/pngjs": "6.0.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/eslint-config-typescript": "14.9.0",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.1",
    "fake-indexeddb": "6.2.8",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "ssim.js": "3.5.0",
    "storybook": "10.6.8",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  }
}
