{
  "name": "tool-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint src contracts vite.config.ts",
    "typecheck": "tsc -p tsconfig.core.json && vue-tsc --noEmit -p tsconfig.app.json",
    "test:unit": "vitest run src",
    "test:contracts": "vitest run contracts",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run test:contracts",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "3.5.45",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/eslint-config-typescript": "14.9.0",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  }
}
